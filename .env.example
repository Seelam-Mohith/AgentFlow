# Optional: without a key, parsing and summaries run deterministically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./agentflow.db
MAX_CRAWL_PAGES=5
CRAWL_TIMEOUT_SECONDS=60
FRONTEND_ORIGIN=http://localhost:3000
# Docker Compose sets BACKEND_URL for the frontend container.
# Next.js reads this in the frontend process, not from the root .env automatically.
# BACKEND_URL=http://127.0.0.1:8000
